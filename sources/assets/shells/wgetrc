# Wget config only used in build stage (defined in common.sh)
# The following option prevent wget from generating too much output
progress=dot:mega
# Disable ~/.wget-hsts file creation
hsts=off
# Bound DNS/connect/read idle time so stuck TLS/peers fail fast; catch_and_retry
# still owns higher-level retries for flaky downloads (Maltego S3, Bitbucket, …)
timeout=30
tries=3
